{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bpm-rust",
  "version": "0.1.0",
  "identifier": "com.bpmrust.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BPM Rust - Modelado de Procesos",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}