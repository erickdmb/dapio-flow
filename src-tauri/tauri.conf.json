{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAPIO-FLOW",
  "version": "0.1.0-alpha.1",
  "identifier": "com.dapioflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DAPIO-FLOW",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}